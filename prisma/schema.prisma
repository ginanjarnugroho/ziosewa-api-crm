generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  suspended
  trial
}

model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar
  status     TenantStatus @default(active)
  webhookUrl String?      @map("webhook_url") @db.VarChar
  apiKey     String       @default(uuid()) @map("api_key") @db.VarChar
  createdAt  DateTime     @default(now()) @map("created_at")

  devices                Device[]
  messageLogs            MessageLog[]
  contacts               Contact[]
  chatMessages           ChatMessage[]
  messageTemplates       MessageTemplate[]
  automationRules        AutomationRule[]
  scheduledNotifications ScheduledNotification[]

  @@map("tenants")
}

enum ChannelType {
  wa_unofficial
  wa_cloud
  telegram
  line
}

enum DeviceStatus {
  connected
  disconnected
  banned
  pairing
}

model Device {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  deviceIdentifier String       @map("device_identifier") @db.VarChar
  channelType      ChannelType  @map("channel_type")
  status           DeviceStatus @default(pairing)
  providerConfig   Json?        @map("provider_config") @db.JsonB
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageLogs      MessageLog[]
  contacts         Contact[]
  chatMessages     ChatMessage[]

  @@map("devices")
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  media
  interactive
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

model MessageLog {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  deviceId    String           @map("device_id") @db.Uuid
  channelType String           @map("channel_type") @db.VarChar
  direction   MessageDirection
  recipient   String           @db.VarChar
  messageType MessageType      @map("message_type")
  payload     Json?            @db.JsonB
  status      MessageStatus    @default(queued)
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("message_logs")
}

model Contact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  deviceId     String   @map("device_id") @db.Uuid
  remoteJid    String   @map("remote_jid") @db.VarChar
  pushName     String?  @map("push_name") @db.VarChar
  verifiedName String?  @map("verified_name") @db.VarChar
  profilePic   String?  @map("profile_pic") @db.VarChar
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, remoteJid]) // A device can only have one contact record per remoteJid
  @@map("contacts")
}

model ChatMessage {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  deviceId    String        @map("device_id") @db.Uuid
  remoteJid   String        @map("remote_jid") @db.VarChar
  messageId   String        @map("message_id") @db.VarChar // WhatsApp message key.id
  isFromMe    Boolean       @map("is_from_me")
  text        String?       @db.Text
  messageType MessageType   @map("message_type")
  timestamp   DateTime
  status      MessageStatus @default(sent)
  mediaUrl    String?       @map("media_url") @db.VarChar // for public URL / CDN
  mediaPath   String?       @map("media_path") @db.VarChar // for local disk path
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, remoteJid, messageId])
  @@index([deviceId, remoteJid, timestamp])
  @@map("chat_messages")
}

enum TriggerType {
  EVENT_STATUS_CHANGED
  TIME_DUE_COUNTDOWN
  TIME_OVERDUE
}

enum OffsetUnit {
  MINUTES
  HOURS
  DAYS
}

enum OffsetDirection {
  IMMEDIATE
  BEFORE
  AFTER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model MessageTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar
  templateText String   @map("template_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules  AutomationRule[]

  @@map("message_templates")
}

model AutomationRule {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  name            String          @db.VarChar
  triggerType     TriggerType     @map("trigger_type")
  targetStatus    String          @default("ANY") @map("target_status") @db.VarChar
  offsetValue     Int             @default(0) @map("offset_value")
  offsetUnit      OffsetUnit      @default(HOURS) @map("offset_unit")
  offsetDirection OffsetDirection @default(IMMEDIATE) @map("offset_direction")
  quietHoursStart String?         @default("20:00") @map("quiet_hours_start") @db.VarChar
  quietHoursEnd   String?         @default("08:00") @map("quiet_hours_end") @db.VarChar
  templateId      String          @map("template_id") @db.Uuid
  isEnabled       Boolean         @default(true) @map("is_enabled")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model ScheduledNotification {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  deviceId     String?            @map("device_id") @db.Uuid
  ruleId       String?            @map("rule_id") @db.Uuid
  orderId      String?            @map("order_id") @db.VarChar
  recipient    String             @db.VarChar
  eventKey     String             @map("event_key") @db.VarChar
  renderedText String             @map("rendered_text") @db.Text
  scheduledAt  DateTime           @map("scheduled_at")
  sentAt       DateTime?          @map("sent_at")
  status       NotificationStatus @default(PENDING)
  retryCount   Int                @default(0) @map("retry_count")
  lastError    String?            @map("last_error") @db.Text
  metadata     Json?              @db.JsonB
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([orderId])
  @@map("scheduled_notifications")
}
